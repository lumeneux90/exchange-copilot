generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String             @id @default(cuid())
  login                   String             @unique
  passwordHash            String             @map("password_hash")
  createdAt               DateTime           @default(now()) @map("created_at")
  sessions                Session[]
  portfolio               Portfolio?
  financialAccounts       FinancialAccount[]
  createdFinancialOrders  FinancialOrder[]   @relation("FinancialOrdersCreated")
  acceptedFinancialOrders FinancialOrder[]   @relation("FinancialOrdersAccepted")

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

enum PortfolioPositionType {
  STOCK
  CURRENCY
}

enum PortfolioTransactionType {
  DEPOSIT
  WITHDRAWAL
  BUY
  SELL
  FX_BUY
  FX_SELL
}

enum BrokerageCurrency {
  RUB
  USD
  EUR
  CNY
}

model Portfolio {
  id           String                 @id @default(cuid())
  userId       String                 @unique @map("user_id")
  cashBalance  Decimal                @default(0) @map("cash_balance") @db.Decimal(20, 8)
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  cashBalances BrokerageCashBalance[]
  positions    PortfolioPosition[]
  transactions PortfolioTransaction[]

  @@map("portfolios")
}

model BrokerageCashBalance {
  id          String            @id @default(cuid())
  portfolioId String            @map("portfolio_id")
  currency    BrokerageCurrency
  balance     Decimal           @default(0) @db.Decimal(20, 8)
  averageRate Decimal?          @map("average_rate") @db.Decimal(20, 8)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  portfolio   Portfolio         @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, currency])
  @@index([portfolioId])
  @@map("brokerage_cash_balances")
}

model PortfolioPosition {
  id           String                @id @default(cuid())
  portfolioId  String                @map("portfolio_id")
  type         PortfolioPositionType
  ticker       String?
  currencyCode String?               @map("currency_code")
  quantity     Decimal               @db.Decimal(20, 8)
  averagePrice Decimal?              @map("average_price") @db.Decimal(20, 8)
  averageRate  Decimal?              @map("average_rate") @db.Decimal(20, 8)
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")
  portfolio    Portfolio             @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, ticker])
  @@unique([portfolioId, currencyCode])
  @@index([portfolioId])
  @@index([portfolioId, type])
  @@map("portfolio_positions")
}

model PortfolioTransaction {
  id           String                   @id @default(cuid())
  portfolioId  String                   @map("portfolio_id")
  type         PortfolioTransactionType
  ticker       String?
  currencyCode String?                  @map("currency_code")
  quantity     Decimal?                 @db.Decimal(20, 8)
  price        Decimal?                 @db.Decimal(20, 8)
  amount       Decimal                  @db.Decimal(20, 8)
  feeAmount    Decimal                  @default(0) @map("fee_amount") @db.Decimal(20, 8)
  executedAt   DateTime                 @default(now()) @map("executed_at")
  createdAt    DateTime                 @default(now()) @map("created_at")
  portfolio    Portfolio                @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId, executedAt(sort: Desc)])
  @@index([portfolioId, type, executedAt(sort: Desc)])
  @@map("portfolio_transactions")
}

enum FinancialAsset {
  RUB
  USD
  XCP
}

enum FinancialOrderStatus {
  OPEN
  ACCEPTED
  CANCELLED
}

model FinancialAccount {
  id        String         @id @default(cuid())
  userId    String         @map("user_id")
  asset     FinancialAsset
  balance   Decimal        @default(0) @db.Decimal(20, 8)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, asset])
  @@map("financial_accounts")
}

model FinancialOrder {
  id               String               @id @default(cuid())
  creatorUserId    String               @map("creator_user_id")
  acceptedByUserId String?              @map("accepted_by_user_id")
  asset            FinancialAsset
  amount           Decimal              @db.Decimal(20, 8)
  status           FinancialOrderStatus @default(OPEN)
  acceptedAt       DateTime?            @map("accepted_at")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  creator          User                 @relation("FinancialOrdersCreated", fields: [creatorUserId], references: [id], onDelete: Cascade)
  acceptedBy       User?                @relation("FinancialOrdersAccepted", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([creatorUserId, createdAt(sort: Desc)])
  @@index([acceptedByUserId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("financial_orders")
}
